# Instagram Credentials
# Copy this file to .env and fill in your actual credentials
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Optional: authenticator-app seed for the account's 2FA. Set this and the server
# generates its own 6-digit code at login, so an unattended restart can complete
# sign-in with no human. Leave unset to supply codes via the instagram_login tool.
# INSTAGRAM_TOTP_SEED=your_totp_seed

# Optional: the sessionid cookie from a browser already signed in to Instagram.
# The way in for accounts whose 2FA is an approve-on-device push, which issues no
# code to type. The server adopts it at startup and writes a durable session, so
# you can remove this again afterwards.
#
# This is a password-equivalent bearer token. It belongs here, in the server's own
# configuration, and must never be pasted into a chat or passed to a tool.
# INSTAGRAM_SESSIONID=your_sessionid_cookie

# MCP transport (optional; CLI flags override these)
# MCP_TRANSPORT=stdio        # stdio | streamable-http | sse
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp

# Rate-limit caps are per category and window, overridable individually, e.g.
# IG_RATE_LIMIT_DM_SEND_PER_DAY=40 or IG_RATE_LIMIT_LIKE_PER_HOUR=15.
#
# Counters live in $HOME/.instagram-mcp-rate-limits.json. If that file cannot be
# written, rate-limited calls are blocked rather than run uncounted, because a
# second process on the same file would reserve from stale counts and push the
# account past its cap. Set this to 1 to keep serving from in-memory counts
# instead — safe only when one process owns the file, and the budget then resets
# on restart.
# IG_RATE_LIMIT_MEMORY_FALLBACK=1

# Bearer token that MCP callers must present as `Authorization: Bearer <token>`.
# REQUIRED whenever the server binds to anything other than loopback: it holds a
# live Instagram session, so an open port means anyone can read and send DMs as
# the account. The server refuses to start on a non-loopback bind without it.
# MCP_AUTH_TOKEN=generate_with_openssl_rand_hex_32
