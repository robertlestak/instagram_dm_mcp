# Instagram Credentials
# Copy this file to .env and fill in your actual credentials
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Optional: authenticator-app seed for the account's 2FA. Set this and the server
# generates its own 6-digit code at login, so an unattended restart can complete
# sign-in with no human. Leave unset to supply codes via the instagram_login tool.
# INSTAGRAM_TOTP_SEED=your_totp_seed

# Optional: the sessionid cookie from a browser already signed in to Instagram.
# The way in for accounts whose 2FA is an approve-on-device push, which issues no
# code to type. The server adopts it at startup and writes a durable session, so
# you can remove this again afterwards.
#
# This is a password-equivalent bearer token. It belongs here, in the server's own
# configuration, and must never be pasted into a chat or passed to a tool.
# INSTAGRAM_SESSIONID=your_sessionid_cookie

# MCP transport (optional; CLI flags override these)
# MCP_TRANSPORT=stdio        # stdio | streamable-http | sse
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp
